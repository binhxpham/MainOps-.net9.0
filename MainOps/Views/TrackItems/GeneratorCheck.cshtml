                            <option value="20">@SharedLocalizer.GetLocalizedHtmlString("20%")</option>
                            <option value="30">@SharedLocalizer.GetLocalizedHtmlString("30%")</option>
                            <option value="40">@SharedLocalizer.GetLocalizedHtmlString("40%")</option>
                            <option value="50">@SharedLocalizer.GetLocalizedHtmlString("50%")</option>
                            <option value="60">@SharedLocalizer.GetLocalizedHtmlString("60%")</option>
                            <option value="70">@SharedLocalizer.GetLocalizedHtmlString("70%")</option>
                            <option value="80">@SharedLocalizer.GetLocalizedHtmlString("80%")</option>
                            <option value="90">@SharedLocalizer.GetLocalizedHtmlString("90%")</option>
                            <option value="100">@SharedLocalizer.GetLocalizedHtmlString("100%")</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Diesel_Level_Comment" class="control-label"></label></td>
                    <td><input asp-for="Diesel_Level_Comment" placeholder="@SharedLocalizer.GetLocalizedHtmlString("Comment:")" class="form-control" style="width:100%;" /></td>
                </tr>

                <tr class="border-top-grey">


                <tr id="spareTankFields" hidden="hidden">
                    <td><label asp-for="SpareTank_Level" class="control-label"></label></td>
                    <td>
                        <select asp-for="SpareTank_Level" class="form-control" style="width:100%;">
                            <option value="0">@SharedLocalizer.GetLocalizedHtmlString("Empty")</option>
                            <option value="10">@SharedLocalizer.GetLocalizedHtmlString("10%")</option>
                            <option value="20">@SharedLocalizer.GetLocalizedHtmlString("20%")</option>
                            <option value="30">@SharedLocalizer.GetLocalizedHtmlString("30%")</option>
                            <option value="40">@SharedLocalizer.GetLocalizedHtmlString("40%")</option>
                            <option value="50">@SharedLocalizer.GetLocalizedHtmlString("50%")</option>
                            <option value="60">@SharedLocalizer.GetLocalizedHtmlString("60%")</option>
                            <option value="70">@SharedLocalizer.GetLocalizedHtmlString("70%")</option>
                            <option value="80">@SharedLocalizer.GetLocalizedHtmlString("80%")</option>
                            <option value="90">@SharedLocalizer.GetLocalizedHtmlString("90%")</option>
                            <option selected="selected" value="100">@SharedLocalizer.GetLocalizedHtmlString("100%")</option>
                        </select>
                    </td>
                </tr>
                <tr id="spareTankComments" hidden="hidden">
                    <td><label asp-for="SpareTank_Level_Comment" class="control-label"></label></td>
                    <td><input asp-for="SpareTank_Level_Comment" placeholder="@SharedLocalizer.GetLocalizedHtmlString("Comment:")" class="form-control" style="width:100%;" /></td>
                </tr>

                <tr class="border-top-grey">




                <tr>
                    <td><label asp-for="Coolant" class="control-label"></label></td>
                    <td>
                        @* <input asp-for="Coolant" class="form-control" style="width:100%;" /> *@
                        <div class="custom-radio">
                            <input type="radio" asp-for="Coolant" id="coolantOK" value="true" checked />
                            <label for="coolantOK" class="control-label">Yes</label>

                            <input type="radio" asp-for="Coolant" id="coolantNotOK" value="false" />
                            <label for="coolantNotOK">No</label>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Coolant_Comment" class="control-label"></label></td>
                    <td><input asp-for="Coolant_Comment" placeholder="@SharedLocalizer.GetLocalizedHtmlString("Comment:")" class="form-control" style="width:100%;" /></td>
                </tr>

                <tr class="border-top-grey">

                <tr>
                    <td><label asp-for="Generator_Started" class="control-label"></label></td>
                    <td>
                        <select asp-for="Generator_Started" class="form-control" style="width:100%;">
                            <option value="No">@SharedLocalizer.GetLocalizedHtmlString("No")</option>
                            <option value="Yes">@SharedLocalizer.GetLocalizedHtmlString("Yes")</option>
                            <option value="Not Applicable">@SharedLocalizer.GetLocalizedHtmlString("Not Applicable")</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Generator_Started_Comment" class="control-label"></label></td>
                    <td><input asp-for="Generator_Started_Comment" placeholder="@SharedLocalizer.GetLocalizedHtmlString("Comment:")" class="form-control" style="width:100%;" /></td>
                </tr>

                <tr class="border-top-grey">

                <tr>
                    <td><label asp-for="Equipment_Started" class="control-label"></label></td>
                    <td>
                        <select asp-for="Equipment_Started" id="equipmentStarted" class="form-control" style="width:100%;">
                            <option value="No">@SharedLocalizer.GetLocalizedHtmlString("No")</option>
                            <option value="Yes">@SharedLocalizer.GetLocalizedHtmlString("Yes")</option>
                            <option value="Not Applicable">@SharedLocalizer.GetLocalizedHtmlString("Not Applicable")</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Equipment_Started_Comment" class="control-label"></label></td>
                    <td><input asp-for="Equipment_Started_Comment" placeholder="@SharedLocalizer.GetLocalizedHtmlString("Comment:")" class="form-control" style="width:100%;" /></td>
                </tr>

                <tr class="border-top-grey">

                <tr>
                    <td><label asp-for="Generator_Stopped" class="control-label"></label></td>
                    <td>
                        <select asp-for="Generator_Stopped" class="form-control" style="width:100%;">
                            <option value="No">@SharedLocalizer.GetLocalizedHtmlString("No")</option>
                            <option value="Yes">@SharedLocalizer.GetLocalizedHtmlString("Yes")</option>
                            <option value="Not Applicable">@SharedLocalizer.GetLocalizedHtmlString("Not Applicable")</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Generator_Stopped_Comment" class="control-label"></label></td>
                    <td><input asp-for="Generator_Stopped_Comment" placeholder="@SharedLocalizer.GetLocalizedHtmlString("Comment:")" class="form-control" style="width:100%;" /></td>
                </tr>

                <tr class="border-top-grey">

                <tr>
                    <td><label asp-for="Equipment_Started_After" class="control-label"></label></td>
                    <td>
                        <select asp-for="Equipment_Started_After" id="equipmentStartedAfter" class="form-control" style="width:100%;">
                            <option value="No">@SharedLocalizer.GetLocalizedHtmlString("No")</option>
                            <option value="Yes">@SharedLocalizer.GetLocalizedHtmlString("Yes")</option>
                            <option value="Not Applicable">@SharedLocalizer.GetLocalizedHtmlString("Not Applicable")</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Equipment_Started_After_Comment" class="control-label"></label></td>
                    <td><input asp-for="Equipment_Started_After_Comment" placeholder="@SharedLocalizer.GetLocalizedHtmlString("Comment:")" class="form-control" style="width:100%;" /></td>
                </tr>


                <tr class="border-top-grey">

                <tr>
                    <td><label asp-for="Generator_Hours" class="control-label"></label></td>
                    <td><input asp-for="Generator_Hours" class="form-control" style="width:100%;" /><span asp-validation-for="Generator_Hours" class="text-danger"></span></td>
                </tr>
                <tr>
                    <td><label asp-for="GeneralComments"></label></td>
                    <td><textarea asp-for="GeneralComments" rows="6" cols="50" style="width:100%;"></textarea></td>
                </tr>
                <tr>
                    <td><label>@SharedLocalizer.GetLocalizedHtmlString("Upload pictures")</label></td>
                    <td><input type="file" name="files" multiple accept=".jpg,.jpeg,.png" style="width:100%" /></td>
                </tr>
                <tr>
                    <td><label asp-for="Latitude" class="control-label"></label></td>
                    <td><input asp-for="Latitude" id="latinput" readonly="readonly" style="width:100%;" /></td>
                </tr>
                <tr>
                    <td><label asp-for="Longitude" class="control-label"></label></td>
                    <td><input asp-for="Longitude" id="longinput" readonly="readonly" style="width:100%;" /></td>
                </tr>
                <tr>
                    <td colspan="2"><b>@SharedLocalizer.GetLocalizedHtmlString("Signature")</b></td>
                </tr>
                <tr>
                    <td colspan="2">
                        <canvas width="330" height="150" id="signature" style="border:1px solid blue;"></canvas>
                    </td>
                </tr>
                <tr>
                    <td style="width:45%">
                        <button type="button" id="accept" class="btn-hoelscher" style="width:100%;height:40px;">@SharedLocalizer.GetLocalizedHtmlString("Accept signature")</button>
                    </td>
                    <td style="width:45%">
                        <button type="button" id="clear" class="btn-hoelscher" style="width:100%;height:40px;">@SharedLocalizer.GetLocalizedHtmlString("Clear signature")</button>
                        <input type="text" id="signaturedata" hidden="hidden" />
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <img width="80" height="60" id="savetarget" hidden="hidden" style="border:1px solid black">
                    </td>
                </tr>
            </table>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer.GetLocalizedHtmlString("Submit")" class="btn-hoelscher" style="width:100%;height:70px;" />
            </div>
            <input asp-for="Signature" value="" hidden="hidden" />
        </form>
    </div>
</div>
<div>
    <a asp-action="MainMenu">@SharedLocalizer.GetLocalizedHtmlString("Back to List")</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/jquery-ui-timepicker-addon.min.js"></script>
    <script src="~/js/signature_pad.min.js"></script>
    <script type="text/javascript">
        var pad = null;
        var id;
        var myLat;
        var myLng;

        if (navigator.geolocation) {
            id = navigator.geolocation.watchPosition(function (position) {
                myLat = position.coords.latitude;
                myLng = position.coords.longitude;
                getPos(myLat, myLng);
            },
                function (error) {
                    if (error.code == error.PERMISSION_DENIED) {
                        //alert("error");
                    }

                }, { maximumAge: 0, timeout: 8000, enableHighAccuracy: true });
        }
        function getPos(lat, lng) {
            $("#latinput").val(lat);
            $("#longinput").val(lng);
        }
        $(document).ready(function () {
            $(function () {
                $(".date-picker").datepicker({
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "-100:+0",
                    dateFormat: "dd-MM-yy",
                    controlType: 'select',
                    firstDay: 1
                });
                $('.date-picker').datepicker("setDate", new Date("dd-MM-yy"));
                document.getElementById('ProjectId').options[0].selected = 'selected';
                FillSubProjects();
            });
        });


        $(document).ready(function () {
            $(function () {
                var canvas = document.querySelector("#signature");
                pad = new SignaturePad(canvas);
                $('#accept').click(function () {
                    var data = pad.toDataURL();
                    $('#savetarget').attr('src', data);
                    var base64signature = data.split(',')[1];
                    $('#signaturedata').val(base64signature);
                    });
                    $('#clear').click(function () {
                        pad.clear();
                    })
            })
        });

        //  $(document).ready(function() {
        //     // Set initial radio button state based on model value
        //     const fullLoadValue = $('#fullLoadValue').val().toLowerCase();
        //     if (fullLoadValue === 'true') {
        //         $('#fullLoad').prop('checked', true);
        //     } else {
        //         $('#noFullLoad').prop('checked', true);
        //     }

        //     // Update hidden field when radio selection of loadType changes
        //     $('input[name="loadType"]').change(function() {
        //         $('#fullLoadValue').val($(this).val());
        //     });
        // });

        $(document).ready(function()
        {
            let forceNo = false;

            // When 'No Full Load' is selected, activate the override
            $('#noFullLoad').on('change', function() {
                if ($(this).is (':checked')) {
                    forceNo = true;
                    //change due to Luca's wishes
                    // $('#equipmentStarted').val('No');
                    // $('#equipmentStartedAfter').val('No');
                }
            });

            // When 'Full Load' is selected, remove the override
            $('#fullLoad').on('change', function() {
                if ($(this).is (':checked')) {
                    forceNo = false;
                }
            });

            // change due to Luca's wishes
            // Always force 'No' if override is active
            // $('#equipmentStarted').on('change', function() {
            //     if (forceNo)
            //     {
            //         $(this).val('No');
            //     }
            // });

            // $('#equipmentStartedAfter').on('change', function() {
            //     if (forceNo)
            //     {
            //         $(this).val('No');
            //     }
            // });
        });

        function retrieveData(e) {
            var posting = true;
            var s1 = document.getElementById("Signature");
            var signature = "";
            signature = document.getElementById("signaturedata").value;
            s1.value = signature;
            if (signature == "") {
                posting = false;
                e.preventDefault();
                alert("Please sign the report!");
            }
            if ($("#theform").valid() == false) {
                posting = false;
            }
            if (posting == true) {
                StartSpinner();
            }
        }

        function FillAddresses() {
            var dropdown = document.getElementById("generatorDropdown");
            var selectedValue = dropdown.value;
            console.log('selectedValue: ' + selectedValue);

            // Get selected option's text
            var selectedText = dropdown.options[dropdown.selectedIndex].text;

            // Output to console for verification
            console.log('Selected Text: ' + selectedText);
                        
            if (selectedText != "Generator Nr. 6 (Atlas Copco)" && selectedText != "Generator Nr. 7 (Atlas Copco)" ){
                $("#adBlueLevelFields").attr('hidden', 'hidden');
                $("#adBlueLevelComments").attr('hidden', 'hidden');
            }else{
                 if ($("#adBlueLevelFields").is(":hidden") == true) {
                        $("#adBlueLevelFields").removeAttr('hidden');
                }

                if ($("#adBlueLevelComments").is(":hidden") == true) {
                        $("#adBlueLevelComments").removeAttr('hidden');
                }
            }

            // Extract address part after " / Adresse: "
            // var address = "";
            // if (selectedValue.includes(" / Adresse: ")) {
            //     address = selectedValue.split(" / Adresse: ")[1];
            // }

            var address = dropdown.value;

            var addressField = document.getElementById("selectedGeneratorValue");
            addressField.value = address;

            //generatorNameValue
            var nameField = document.getElementById("generatorNameValue");
            nameField.value = selectedText;
         }

        function FillSubProjects() {
            var ProjectId = $('#ProjectId').val();
            console.log('Project Id: ' + ProjectId);
            
            if ($("#adBlueLevelFields").is(":hidden") == true) {
                $("#adBlueLevelFields").removeAttr('hidden');
            }
            
            if ($("#adBlueLevelComments").is(":hidden") == true) {
                $("#adBlueLevelComments").removeAttr('hidden');
            }

            // Show or hide the <tr> based on ProjectId
            if (ProjectId == "437" || ProjectId == "653" ) {
                if ($("#testtypefields").is(":hidden") == true) {
                        $("#testtypefields").removeAttr('hidden');
                }

                if ($("#testtypecomments").is(":hidden") == true) {
                     $("#testtypecomments").removeAttr('hidden');
                }

                if ($("#address").is(":hidden") == true) {
                     $("#address").removeAttr('hidden');
                }

                if ($("#generatorName").is(":hidden") == true) {
                     $("#generatorName").removeAttr('hidden');
                }

                //spareTankFields
                 if ($("#spareTankFields").is(":hidden") == true) {
                     $("#spareTankFields").removeAttr('hidden');
                }

                //spareTankComments
                if ($("#spareTankComments").is(":hidden") == true) {
                     $("#spareTankComments").removeAttr('hidden');
                }

                $("#generatorNameLocation").attr('hidden', 'hidden');
            } else {
                 $("#testtypefields").attr('hidden', 'hidden'); // Add the hidden attribute back
                 $("#testtypecomments").attr('hidden', 'hidden');
                 $("#address").attr('hidden', 'hidden');
                 $("#generatorName").attr('hidden', 'hidden');
                 $("#spareTankFields").attr('hidden', 'hidden');
                 $("#spareTankComments").attr('hidden', 'hidden');

                 if ($("#generatorNameLocation").is(":hidden") == true) {
                     $("#generatorNameLocation").removeAttr('hidden');
                }
            }

            var url = '@Url.Action("GetSubProjectList", "SubProjects")';
            $.ajax({
                type: 'GET',
                url: url,
                dataType: 'json',
                data: { 'theId': ProjectId },
                success: function (data) {
                    if (data.length > 0) {
                        var s = '<option value="">Please Select SubProject</option>';
                        for (var prop in data) {
                            s += '<option value="' + data[prop]["id"] + '">' + data[prop]["name"] + '</option>';
                        }
                        $("#SubProjectId").html(s);
                        document.getElementById("SubProjectId").style.width = "100%";
                    }
                    else {
                        var s = '<option value="">Please Select SubProject</option>';
                        $("#SubProjectId").html(s);
                    }
                }
            });
        }

    </script>



}
@model IEnumerable<MainOps.Models.ReportClasses.Daily_Report_2>

@{
    ViewData["Title"] = SharedLocalizer.GetLocalizedHtmlString("Manage Check Reports");
}

@Html.AntiForgeryToken()

<h2 class="mb-4 text-end">@SharedLocalizer.GetLocalizedHtmlString("Checked Reports")</h2>
@if (User.IsInRole("Admin") || User.IsInRole("DivisionAdmin") || User.IsInRole("Manager"))
{    
    <div>
        <!-- Back button -->
        <form asp-action="DailyReports" method="get" class="mb-5 text-end">
            <button class="btn-hoelscher">
                @SharedLocalizer.GetLocalizedHtmlString("Back to all daily reports")
            </button>
        </form>

        <!-- Filter form -->
        <form asp-controller="TrackItems" asp-action="ManageCheckedDailyReports" method="get" class="card p-4 shadow-sm">

            <!-- Row 1: Project + Subproject -->
            <div class="row g-4 text-end justify-content-end align-items-end">
                <div class="col-md-4">
                    <label for="ProjectId" class="form-label fw-bold">
                        @SharedLocalizer.GetLocalizedHtmlString("Project"):
                    </label>
                    <select id="ProjectId"
                            name="ProjectId"
                            class="form-select form-select-lg"
                            onchange="FillSubProjects();"
                            asp-items="ViewBag.ProjectId">
                        <option value="@null">@SharedLocalizer.GetLocalizedHtmlString("All")</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="SubProjectId" class="form-label fw-bold">
                        @SharedLocalizer.GetLocalizedHtmlString("Subproject"):
                    </label>
                    <select id="SubProjectId"
                            name="SubProjectId"
                            class="form-select form-select-lg"
                            asp-items="ViewBag.SubProjectId">
                        <option value="@null">@SharedLocalizer.GetLocalizedHtmlString("All")</option>
                    </select>
                </div>
            </div>

            <!-- Row 2: Checkbox + Update button -->
            <div class="row mt-4 text-end justify-content-end align-items-center">
                <div class="col-md-8 d-flex justify-content-end align-items-center gap-3 flex-wrap">
                    <div class="form-check d-flex align-items-center">
                        <label class="form-check-label fw-bold" for="all">
                            @SharedLocalizer.GetLocalizedHtmlString("Get All Reports:")
                        </label>
                        <input type="checkbox"
                               class="form-check-input me-2"
                               id="all"
                               name="all"
                               value="@(ViewBag.all == true ? "true" : "false")"
                               @(ViewBag.all == true ? "checked" : "")
                               onchange="this.value = this.checked; applytheall(this);" />                       
                    </div>

                    <button type="submit" class="btn-hoelscher">
                        @SharedLocalizer.GetLocalizedHtmlString("Update")
                    </button>
                </div>
            </div>

        </form>
    </div>

    <style>
        .tobepaid-cell { /* optional padding etc. */
        }

            .tobepaid-cell.status-yes {
                background-color: lightgreen;
            }

            .tobepaid-cell.status-no {
                background-color: lightcoral;
            }

            .tobepaid-cell.status-undef {
                background-color: yellow;
            }

        /* If Bootstrap's table-striping overrides your color, add !important or higher specificity:
        table.table .tobepaid-cell.status-yes { background-color: lightgreen !important; }
        */

        /* Increase dropdown height */
        .form-select-lg {
            height: 38px;
            font-size: 1.5rem;
        }

        /* Add spacing between sections */
        .card {
            margin-top: 30px;
        }

        /* Align checkbox and button nicely */
        @@media (min-width: 768px) {
            .form-check,
            .btn-hoelscher {
                align-self: flex-end;
            }
        }

        .gap-3 {
            gap: 1.2rem !important;
        }
    </style>

    <table style="width:100%;table-layout:fixed;">
        <thead>
            <tr>
                <th style="width:9%;">
                    @Html.DisplayNameFor(model => model.Project.Name)
                </th>

                <th style="width:8%;">
                    @Html.DisplayNameFor(model => model.short_Description)
                </th>
                <th style="width:5%;">
                    @Html.DisplayNameFor(model => model.tobepaid)
                </th>
                <th style="width:9%;">
                    @Html.DisplayNameFor(model => model.Report_Date)
                </th>
                <th style="width:8%;">
                    @Html.DisplayNameFor(model => model.Hours)
                </th>
                <th style="width:15%;">
                    @Html.DisplayNameFor(model => model.Work_Performed)
                </th>
                <th style="width:9%;">
                    @Html.DisplayNameFor(model => model.DoneBy)
                </th>
                <th style="width:4%;">
                    @Html.DisplayNameFor(model => model.Amount)
                </th> 
                <th style="width:4%;">
                    @Html.DisplayNameFor(model => model.Checked_By)
                </th>
                <th>@Html.DisplayNameFor(model => model.VariationOrder)</th>
                <th style="width:25%;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr style="border-bottom: 2px solid #ddf; ">
                    <td>
                        @if (item.SubProjectId != null)
                        {
                            <text>
                                @Html.DisplayFor(modelItem => item.Project.Abbreviation) - @Html.DisplayFor(modelItem => item.SubProject.Name)
                            </text>
                        }
                        else
                        {
                            @Html.DisplayFor(modelItem => item.Project.Abbreviation)
                        }

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.short_Description)
                    </td>
                    @* @if (item.tobepaid == null)
                    {
                        <td style="background-color:yellow;overflow-wrap:break-word;">@SharedLocalizer.GetLocalizedHtmlString("Undefined")</td>
                    }
                    else if (item.tobepaid == 1)
                    {
                        <td style="background-color:lightgreen;">@SharedLocalizer.GetLocalizedHtmlString("Yes")</td>
                    }
                    else
                    {
                        <td style="background-color:lightcoral;">@SharedLocalizer.GetLocalizedHtmlString("No")</td>
                    } *@

                    <td id="tobepaid-cell-@item.Id" class="tobepaid-cell @(item.tobepaid == null ? "status-undef" : item.tobepaid == 1 ? "status-yes" : "status-no")">
                        <span class="tobepaid-text">
                            @(item.tobepaid == null ? SharedLocalizer.GetLocalizedHtmlString("Undefined") :
                                                      item.tobepaid == 1 ? SharedLocalizer.GetLocalizedHtmlString("Yes") :
                                                                          SharedLocalizer.GetLocalizedHtmlString("No"))
                        </span>
                    </td>


                    <td>
                        @Html.DisplayFor(modelItem => item.Report_Date)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Hours)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Work_Performed)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DoneBy)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Amount)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Checked_By)
                    </td>
                    <td>
                        @if (item.VariationOrderId != null)
                        {
                            @Html.DisplayFor(modelItem => item.VariationOrder.HeadLine)
                        }

                    </td>
                    <td>
                        <table style="width:100%;table-layout:fixed;">
                            <tr>
                                <td>
                                    @*<form asp-action="MakePaid" method="post" asp-route-id="@item.Id" >*@
                                    <button onclick="ApprovePaid(@item.Id);" class="btn-hoelscher">@SharedLocalizer.GetLocalizedHtmlString("Approve Paid")</button>
                                    @if (ViewBag.all == true)
                                    {
                                        <input type="checkbox" class="allclass" name="all" value="true" checked="checked" hidden="hidden" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="allclass" name="all" value="false" hidden="hidden" />
                                    }
                                    @*</form>*@
                                </td>
                                <td>
                                    @*<form asp-action="MakeUnPaid" method="post" asp-route-id="@item.Id">*@
                                    <button onclick="ApproveUnPaid(@item.Id);" class="btn-hoelscher">@SharedLocalizer.GetLocalizedHtmlString("Approve Unpaid")</button>
                                    @if (ViewBag.all == true)
                                    {
                                        <input type="checkbox" class="allclass" name="all" value="true" checked="checked" hidden="hidden" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="allclass" name="all" value="false" hidden="hidden" />
                                    }
                                    @*</form>*@
                                </td>
                            </tr>
                            <tr>                       
                                <td>
                                    <form asp-action="Daily_Report_2_DetailsPdf" method="get" asp-route-id="@item.Id" target="_blank">
                                        <button class="btn-hoelscher">@SharedLocalizer.GetLocalizedHtmlString("View Report")</button>
                                    </form>
                                </td>
                                <td>
                                    <form asp-action="Edit_DailyReport_2" asp-route-id="@item.Id" method="get" target="_blank">
                                        <button class="btn-hoelscher">@SharedLocalizer.GetLocalizedHtmlString("Edit Report")</button>
                                    </form>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <form asp-action="Delete_DailyReport" method="get" asp-route-id="@item.Id" target="_blank">
                                        <button class="btn-hoelscher">@SharedLocalizer.GetLocalizedHtmlString("Delete Report")</button>
                                    </form>
                                </td>

                                <td>
                                    <form asp-controller="DailyReport" asp-action="SplitDailyReport" asp-route-id="@item.Id" method="get" target="_blank">
                                        <button class="btn-hoelscher">@SharedLocalizer.GetLocalizedHtmlString("Split")</button>
                                    </form>
                                </td>
                            </tr>

                          

                        </table>
                    </td>
                </tr>
            }

        </tbody>
    </table>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/jquery-ui-timepicker-addon.min.js"></script>
    <script type="text/javascript">
        // optional: set the antiforgery header globally
        $.ajaxSetup({
          headers: {
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
          }
        });

        $(document).ready(function () {
            $(function () {

                FillSubProjects();
            });
        });



        const applytheall = (elem) => {
                var array = document.getElementsByClassName("allclass");
                for (var i = 0; i < array.length; i++) {
                    if (array[i].type == "checkbox") {
                        if (array[i].className == "allclass") {
                            array[i].checked = elem.value;
                            array[i].value = elem.value;
                        } else if (array[i].checked) {
                            array[i].checked = elem.value;
                            array[i].value = elem.value;
                        }
                    }

                }
            }
        function MakePaid(theid) {
            var url = '@Url.Action("MakePaidAjax", "TrackItems")';
            $.ajax({
                type: 'POST',
                url: url,
                data: { 'id': theid },
                success: function (data) {
                    alert("Made Paid");
                }

            });
        }

        function ApprovePaid_work(theid) { //both "approved" and "paid"
            var url = '@Url.Action("ApprovePaidAjax", "TrackItems")';
            $.ajax({
                type: 'POST',
                url: url,
                data: { 'id': theid },
                success: function (data) {
                    alert("Approved and Paid!");
                }
            });
        }

        
         function ApprovePaid(theid) { // both "approved" and "paid"
              var url = '@Url.Action("ApprovePaidAjax", "TrackItems")';

              $.ajax({
                type: 'POST',
                url: url,
                data: { id: theid },
                success: function (data) {
                  // Expecting { ok: true, tobepaid: 1, label: "Yes" }
                  var $cell = $('#tobepaid-cell-' + theid);
                  $cell.removeClass('status-yes status-no status-undef');
                  $cell.addClass('status-yes');
                  $cell.find('.tobepaid-text').text(data.label);
                                 

              // Optional toast/alert
              alert("@SharedLocalizer.GetLocalizedHtmlString("Approved and Paid")");
            },
            error: function (xhr) {
              alert((xhr.responseJSON && xhr.responseJSON.message) || 'Error');
            }
          });
        }

          function ApproveUnPaid(theid) { // both "approved" and "unpaid"
              var url = '@Url.Action("ApproveUnpaidAjax", "TrackItems")';

              $.ajax({
                type: 'POST',
                url: url,
                data: { id: theid },
                success: function (data) {
                  // Expecting { ok: true, tobepaid: 1, label: "Yes" }
                  var $cell = $('#tobepaid-cell-' + theid);
                  $cell.removeClass('status-yes status-no status-undef');
                  $cell.addClass('status-no');
                  $cell.find('.tobepaid-text').text(data.label);

                 

              // Optional toast/alert
              alert("@SharedLocalizer.GetLocalizedHtmlString("Approved and Unpaid")");
            },
            error: function (xhr) {
              alert((xhr.responseJSON && xhr.responseJSON.message) || 'Error');
            }
          });
        }


        function MakeUnPaid(theid) {
            var url = '@Url.Action("MakeUnPaidAjax", "TrackItems")';
            $.ajax({
                type: 'POST',
                url: url,
                data: { 'id': theid },
                success: function (data) {
                    alert("Made UnPaid");
                }

            });
        }

        function ApproveUnPaid_work(theid) { //both "approved" and "unpaid"
            var url = '@Url.Action("ApproveUnpaidAjax", "TrackItems")';
            $.ajax({
                type: 'POST',
                url: url,
                data: { 'id': theid },
                success: function (data) {
                    alert("Approved and Unpaid!");
                }
            });
        }


        function Approve(theid) {
            var url = '@Url.Action("ApproveAjax", "TrackItems")';
            $.ajax({
                type: 'POST',
                url: url,
                data: { 'id': theid },
                success: function (data) {
                    alert("Approved");
                }

            });
        }
        function FillSubProjects() {
            var SubProjectId = $('#SubProjectId').val();
            var ProjectId = $('#ProjectId').val();
            var url = '@Url.Action("GetSubProjectList", "SubProjects")';
            $.ajax({
                type: 'GET',
                url: url,
                dataType: 'json',
                data: { 'theId': ProjectId },
                success: function (data) {
                    if (data.length > 0) {
                        var s = '<option value="">Please Select SubProject</option>';
                        for (var prop in data) {
                            s += '<option value="' + data[prop]["id"] + '">' + data[prop]["name"] + '</option>';
                        }
                        $("#SubProjectId").html(s);
                        document.getElementById("SubProjectId").style.width = "100%";
                        var x = document.getElementById("SubProjectId");
                        var i;
                        for (i = 0; i < x.length; i++) {
                            if (x.options[i].value == SubProjectId) {
                                x.options[i].selected = true;
                            }
                        }
                    }
                    else {
                        var s = '<option value="">Please Select SubProject</option>';
                        $("#SubProjectId").html(s);
                    }
                }
            });
        }
    </script>
}
